generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Operator {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  display_name  String
  logo          String?
  primary_color String?
  website       String?
  recharge_url  String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans         Plan[]
  sources       Source[]
}

model Circle {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  state     String?
  region    String?
  status    String   @default("ACTIVE")

  plans     Plan[]
}

model Plan {
  id               String   @id @default(uuid())
  operator_id      String
  circle_id        String

  plan_name        String?
  price            Float

  plan_type        String
  category         String
  subcategory      String?

  validity_value   Int
  validity_unit    String   @default("DAYS")

  data_type        String   @default("FIXED") // FIXED, DAILY, UNLIMITED, etc.
  data_total       Float?
  data_per_day     Float?
  data_unit        String   @default("GB")

  voice_minutes    Int?
  voice_type       String?  // UNLIMITED, LOCAL, etc.

  sms_total        Int?
  sms_per_day      Int?

  network_type     String?  // 4G, 5G, 4G+5G
  five_g           Boolean  @default(false)
  unlimited_5g     Boolean  @default(false)

  ott_available    Boolean  @default(false)
  ott_details      Json?

  weekend_rollover Boolean  @default(false)
  night_data       Boolean  @default(false)
  data_rollover    Boolean  @default(false)
  data_delight     Boolean  @default(false)

  benefits_json    Json?
  eligibility_json Json?

  source_url       String?
  source_type      String?

  effective_from   DateTime?
  effective_until  DateTime?

  last_verified_at DateTime?

  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  operator         Operator @relation(fields: [operator_id], references: [id])
  circle           Circle   @relation(fields: [circle_id], references: [id])
  
  verifications    PlanVerification[]
  sources          PlanSource[]
}

model Source {
  id              String   @id @default(uuid())
  operator_id     String
  source_type     String
  source_url      String
  source_name     String
  last_fetched_at DateTime?
  last_success_at DateTime?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  operator        Operator @relation(fields: [operator_id], references: [id])
  planSources     PlanSource[]
}

model PlanSource {
  id             String   @id @default(uuid())
  plan_id        String
  source_id      String
  source_plan_id String?
  retrieved_at   DateTime @default(now())
  content_hash   String?
  createdAt      DateTime @default(now())

  plan           Plan     @relation(fields: [plan_id], references: [id])
  source         Source   @relation(fields: [source_id], references: [id])
}

model PlanVerification {
  id                String   @id @default(uuid())
  plan_id           String
  verified_by       String?
  verification_type String
  verified_at       DateTime @default(now())
  status            String
  notes             String?

  plan              Plan     @relation(fields: [plan_id], references: [id])
}
